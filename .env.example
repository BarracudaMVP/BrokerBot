# Токен от BotFather. Там же: /setprivacy → Disable, иначе бот не видит сообщения в группах.
BOT_TOKEN=
# Для запуска без docker. В compose DATABASE_URL задаётся самим compose.
DATABASE_URL=postgres://brokerbot:brokerbot@localhost:5432/brokerbot?sslmode=disable
# Канал с копиями переписки. Бот должен быть его админом. Пусто — копии не отправляются.
LOG_CHANNEL_ID=
# Начальные админы, через запятую.
ADMIN_IDS=
TIMEZONE=Europe/Moscow
# Секрет для HMAC номеров карт в скам-листе. Менять нельзя: старые хеши перестанут совпадать.
CARD_HASH_SECRET=

# Только для docker compose.
POSTGRES_PASSWORD=brokerbot
POSTGRES_PORT=5432
